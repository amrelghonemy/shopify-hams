<section class="categories-section">
  <div class="container">
    <div style="text-align:center;">
      <h2 class="section-title">{{ section.settings.title }}</h2>
    </div>
    <div class="categories-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="category-card" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}">
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag }}
          {% endif %}
          <div class="category-overlay"></div>
          <div class="category-hover-content">
            <h3>{{ block.settings.title }}</h3>
            <p>Shop Now</p>
          </div>
          <div class="category-default-label"><h3>{{ block.settings.title }}</h3></div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Categories",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "تسوقي حسب الفئة"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "فساتين"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Categories",
      "blocks": [
        { "type": "category", "settings": { "title": "فساتين" } },
        { "type": "category", "settings": { "title": "بلوزات" } },
        { "type": "category", "settings": { "title": "بناطيل" } }
      ]
    }
  ]
}
{% endschema %}