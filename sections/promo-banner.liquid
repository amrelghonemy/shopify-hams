<section class="promo-section">
  <div class="container">
    <div class="promo-banner">
      {% if section.settings.background_image != blank %}
        <div class="promo-bg-img" style="background-image: url({{ section.settings.background_image | image_url: width: 1200 }});"></div>
      {% endif %}
      <div class="promo-content">
        <p class="promo-tagline">{{ section.settings.tagline }}</p>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.description }}</p>
        <a href="{{ section.settings.button_link }}" class="btn-hero-primary">{{ section.settings.button_label }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "مجموعة حصرية"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ارتقِ بإطلالتك اليومية"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "قطع مختارة بعناية لتناسب كل لحظة."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "تسوقي الآن"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Promo Banner"
    }
  ]
}
{% endschema %}