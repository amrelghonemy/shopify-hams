<section class="hams-promo">
  <div class="page-width">
    <div class="hams-promo__banner">
      {% if section.settings.background_image != blank %}
        <img src="{{ section.settings.background_image | image_url: width: 1200 }}" alt="" class="hams-promo__bg" loading="lazy">
      {% endif %}
      <div class="hams-promo__content">
        <p class="hams-promo__tagline">{{ section.settings.tagline }}</p>
        <h2 class="hams-promo__heading">{{ section.settings.heading }}</h2>
        <p class="hams-promo__desc">{{ section.settings.description }}</p>
        <a href="{{ section.settings.button_link }}" class="hams-btn hams-btn--primary">{{ section.settings.button_label }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "مجموعة حصرية"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ارتقِ بإطلالتك اليومية"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "قطع مختارة بعناية لتناسب كل لحظة."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "تسوقي الآن"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Promo Banner"
    }
  ]
}
{% endschema %}
