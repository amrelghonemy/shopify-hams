<section class="why-section">
  <div class="container">
    <div style="text-align:center;">
      <h2 class="section-title">{{ section.settings.title | default: 'sections.why_us.title' | t }}</h2>
    </div>
    <div class="why-grid">
      {% for block in section.blocks %}
        <div class="why-card" {{ block.shopify_attributes }}>
          <div class="why-icon">
            {% case block.settings.icon %}
              {% when 'shield' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              {% when 'truck' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              {% when 'credit-card' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
              {% when 'chat' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            {% endcase %}
          </div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Choose Us",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "لماذا Hams Style"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Truck" },
            { "value": "credit-card", "label": "Credit Card" },
            { "value": "chat", "label": "Chat" }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "جودة تستحق الثقة"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "منتجات مختارة بعناية وبجودة عالية"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Choose Us",
      "blocks": [
        { "type": "feature", "settings": { "icon": "shield", "title": "جودة تستحق الثقة", "description": "منتجات مختارة بعناية وبجودة عالية" } },
        { "type": "feature", "settings": { "icon": "truck", "title": "شحن مجاني", "description": "للطلبات فوق 500 جنيه" } },
        { "type": "feature", "settings": { "icon": "credit-card", "title": "دفع آمن", "description": "طرق دفع آمنة وسهلة" } },
        { "type": "feature", "settings": { "icon": "chat", "title": "خدمة العملاء", "description": "نحن هنا لمساعدتك قبل وبعد الطلب" } }
      ]
    }
  ]
}
{% endschema %}