                        "product_tabs": {
                            "type": "_vtls-product-tabs",
                            "settings": {
                                "number_of_tabs": "3",
                                "tab_1_title": "\u0627\u0644\u0648\u0635\u0641",
                                "tab_1_text": "{{ product.description }}",
                                "tab_2_title": "\u0627\u0644\u0634\u062d\u0646",
                                "tab_2_text": "<p>\u0646\u0648\u0644\u064a \u0639\u0646\u0627\u064a\u0629 \u0643\u0628\u064a\u0631\u0629 \u0641\u064a \u062a\u062c\u0647\u064a\u0632 \u0637\u0644\u0628\u0643 \u0648\u062a\u0633\u0644\u064a\u0645\u0647.<\/p><p><strong>\u0648\u0642\u062a \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629<\/strong><br\/>\u062a\u062a\u0645 \u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0639\u0627\u062f\u0629 \u062e\u0644\u0627\u0644 1-3 \u0623\u064a\u0627\u0645 \u0639\u0645\u0644. \u0628\u0639\u062f \u0634\u062d\u0646 \u0637\u0644\u0628\u0643\u060c \u0633\u062a\u062a\u0644\u0642\u0649 \u0631\u0633\u0627\u0644\u0629 \u062a\u0623\u0643\u064a\u062f \u0634\u062d\u0646 \u0639\u0628\u0631 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a. \u0642\u062f \u064a\u062a\u0645 \u062a\u0636\u0645\u064a\u0646 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u062a\u062a\u0628\u0639 \u0639\u0646\u062f \u062a\u0648\u0641\u0631\u0647\u0627.<\/p><p><strong>\u0627\u0644\u0645\u062f\u0629 \u0627\u0644\u0645\u062a\u0648\u0642\u0639\u0629 \u0644\u0644\u062a\u0633\u0644\u064a\u0645<\/strong><br\/>\u062a\u0635\u0644 \u0645\u0639\u0638\u0645 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u062e\u0644\u0627\u0644 5-10 \u0623\u064a\u0627\u0645 \u0639\u0645\u0644. \u0642\u062f \u062a\u062e\u062a\u0644\u0641 \u0623\u0648\u0642\u0627\u062a \u0627\u0644\u062a\u0633\u0644\u064a\u0645 \u062d\u0633\u0628 \u0645\u0648\u0642\u0639\u0643 \u0648\u0627\u0644\u062c\u062f\u0648\u0644 \u0627\u0644\u062a\u0634\u063a\u064a\u0644\u064a \u0644\u0634\u0631\u0643\u0629 \u0627\u0644\u0634\u062d\u0646.<\/p><p><strong>\u0631\u0633\u0648\u0645 \u0627\u0644\u0634\u062d\u0646<\/strong><br\/>\u064a\u062a\u0645 \u0627\u062d\u062a\u0633\u0627\u0628 \u062a\u0643\u0627\u0644\u064a\u0641 \u0627\u0644\u0634\u062d\u0646 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0639\u0646\u062f \u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u0634\u0631\u0627\u0621\u060c \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0645\u0648\u0642\u0639\u0643 \u0648\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u0627\u0644\u0645\u062d\u062f\u062f\u0629.<\/p>",
                                "tab_3_title": "\u0627\u0644\u0625\u0631\u062c\u0627\u0639",
                                "tab_3_text": "<p>\u0631\u0636\u0627\u0643 \u0647\u0648 \u0623\u0648\u0644\u0648\u064a\u062a\u0646\u0627 \u0627\u0644\u0642\u0635\u0648\u0649\u060c \u0648\u0646\u0631\u064a\u062f\u0643 \u0623\u0646 \u062a\u062a\u0633\u0648\u0651\u0642 \u0645\u0639\u0646\u0627 \u0628\u062b\u0642\u0629. \u0625\u0630\u0627 \u0643\u0627\u0646 \u0647\u0646\u0627\u0643 \u0623\u064a \u0634\u064a\u0621 \u063a\u064a\u0631 \u0645\u0646\u0627\u0633\u0628\u060c \u064a\u0645\u0643\u0646\u0643 \u0637\u0644\u0628 \u0625\u0631\u062c\u0627\u0639 \u0623\u0648 \u0627\u0633\u062a\u0631\u062f\u0627\u062f \u062e\u0644\u0627\u0644 30 \u064a\u0648\u0645\u064b\u0627 \u0645\u0646 \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0633\u0644\u064a\u0645.<\/p><p><strong>\u0643\u064a\u0641\u064a\u0629 \u0628\u062f\u0621 \u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u0625\u0631\u062c\u0627\u0639<\/strong><br\/>\u0645\u0627 \u0639\u0644\u064a\u0643 \u0633\u0648\u0649 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0645\u0639 \u0641\u0631\u064a\u0642 \u0627\u0644\u062f\u0639\u0645 \u0644\u062f\u064a\u0646\u0627 \u0648\u0633\u0646\u0631\u0634\u062f\u0643 \u062e\u0644\u0627\u0644 \u0627\u0644\u0639\u0645\u0644\u064a\u0629. \u0648\u0633\u0646\u062a\u0623\u0643\u062f \u0645\u0646 \u0623\u0646 \u062a\u0643\u0648\u0646 \u0628\u0633\u064a\u0637\u0629 \u0648\u0628\u062f\u0648\u0646 \u0639\u0646\u0627\u0621.<\/p><p><strong>\u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0627\u0644\u0623\u0645\u0648\u0627\u0644<\/strong><br\/>\u0628\u0645\u062c\u0631\u062f \u0645\u0639\u0627\u0644\u062c\u0629 \u0637\u0644\u0628 \u0627\u0644\u0625\u0631\u062c\u0627\u0639 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643\u060c \u0633\u064a\u062a\u0645 \u0631\u062f \u0627\u0644\u0645\u0628\u0644\u063a \u0625\u0644\u0649 \u0648\u0633\u064a\u0644\u0629 \u0627\u0644\u062f\u0641\u0639 \u0627\u0644\u0623\u0635\u0644\u064a\u0629\u060c \u0639\u0627\u062f\u0629\u064b \u062e\u0644\u0627\u0644 5-10 \u0623\u064a\u0627\u0645 \u0639\u0645\u0644.<\/p>"
                            }
